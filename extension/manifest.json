{
  "manifest_version": 3,
  "name": "pinpoint",
  "version": "0.3.0",
  "description": "Inject the pinpoint annotate client into pages that match a url registry entry; the toolbar icon opens the annotation side panel.",
  "permissions": ["scripting", "sidePanel"],
  "host_permissions": [
    "https://*.localhost/*",
    "http://*.localhost/*",
    "https://localhost/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "pinpoint 标注",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.localhost/*",
        "http://*.localhost/*",
        "https://localhost/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "all_frames": false
    }
  ]
}
