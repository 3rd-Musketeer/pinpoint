{
  "manifest_version": 3,
  "name": "pinpoint",
  "version": "0.1.0",
  "description": "Inject the pinpoint annotate client into pages that match a url registry entry.",
  "content_scripts": [
    {
      "matches": [
        "https://*.localhost/*",
        "http://*.localhost/*",
        "https://localhost/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "all_frames": false
    }
  ]
}
