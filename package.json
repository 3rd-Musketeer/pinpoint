{
  "name": "pinpoint",
  "private": true,
  "type": "module",
  "bin": {
    "pinpoint": "bin/pinpoint.mjs",
    "ppnt": "bin/pinpoint.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "portless run --name pinpoint npm run dev:app",
    "dev:app": "vite",
    "dev:direct": "npm run dev:app",
    "build:workbench": "node scripts/build-workbench.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src site/src bin scripts content/kits",
    "test": "npm run lint --silent && node --test",
    "test:e2e": "node scripts/e2e-parallel.mjs",
    "check": "npm test && npm run test:site && npm run test:e2e",
    "test:e2e:serial": "playwright test",
    "site:dev": "cd site && astro dev",
    "site:build": "cd site && astro build",
    "test:site": "node --test site/build.check.mjs"
  },
  "devDependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.2",
    "@floating-ui/dom": "1.8.0",
    "@iconify-json/logos": "^1.2.16",
    "@iconify-json/simple-icons": "^1.2.100",
    "@playwright/test": "1.61.1",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-query": "^5.101.4",
    "astro": "7.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.12",
    "lucide": "^1.23.0",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "tailwind-merge": "^3.6.0",
    "unified": "11.0.5",
    "zustand": "^5.0.14"
  }
}
