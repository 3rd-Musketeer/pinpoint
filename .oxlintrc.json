{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-undef": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "site/.astro/**"
  ],
  "globals": {
    "Astro": "readonly"
  }
}
