---
// 站点外壳：顶栏（project 面包屑 + 概念 + 深浅色）、左目录、正文、右评论栏、概念抽屉。
// 评论栏的内容由 pinpoint 注入的标注客户端填（src/client/prose-comments.js，[data-pp-rail]）；
// 没有注入（站点单独跑、以后的公开链接）时只留这句说明。
// 样子照 tasks/2026-10-13-pp3/preview/index.html。
import '../styles/site.css';

interface Crumb { label: string; href?: string }
interface TocItem { id: string; title: string; letter: string }
interface DrawerItem { label: string; href?: string; count: number }
interface Props {
  title: string;
  description?: string;
  project: string;
  crumbs: Crumb[];
  toc?: TocItem[];
  rail?: boolean;
  drawer?: { have: DrawerItem[]; empty: DrawerItem[] };
  errors?: string[];
}
const { title, description, project, crumbs, toc, rail = false, drawer, errors = [] } = Astro.props;
const layoutClass = toc ? (rail ? 'layout' : 'layout no-rail') : 'layout single';
const llms = `/${encodeURIComponent(project)}/llms.txt`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="alternate" type="text/plain" href={llms} title="Agent 视图" />
    <script is:inline>
      try { var t = localStorage.getItem('pp-site-theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    </script>
  </head>
  <body>
    <header class="top">
      <div class="crumb">
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <span>/</span>}
            {i === crumbs.length - 1 ? <b>{c.label}</b> : c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
          </>
        ))}
      </div>
      <div class="sp"></div>
      {drawer && (
        <button class="btn" id="btn-concepts" type="button" aria-controls="drawer" aria-expanded="false">
          概念{drawer.empty.length > 0 && <span> · {drawer.empty.length} 个空 ref</span>}
        </button>
      )}
      <a class="btn hide-sm" href={llms}>llms.txt</a>
      <button class="btn" id="btn-theme" type="button" aria-label="切换深浅色">◐</button>
    </header>

    <div class={layoutClass}>
      {toc && (
        <nav class="toc" aria-label="目录">
          <div class="label">目录</div>
          <ol id="toc">
            {toc.map((s) => <li><a href={`#${s.id}`}><span class="n">{s.letter}</span>{s.title}</a></li>)}
          </ol>
        </nav>
      )}
      <main id="article">
        {errors.length > 0 && (
          <div class="errors" role="alert">
            <b>内容错误（构建会失败）</b>
            <ul>{errors.map((e) => <li>{e}</li>)}</ul>
          </div>
        )}
        <slot />
      </main>
      {rail && (
        <aside class="rail" id="rail" aria-label="评论" data-pp-rail>
          <div class="label">评论</div>
          <p class="empty-rail">经本机 pinpoint 打开时，选中正文就能评论。</p>
        </aside>
      )}
    </div>

    {drawer && (
      <aside class="drawer" id="drawer" hidden aria-label="概念">
        <h3>本篇用到的</h3>
        <ul>
          {drawer.have.length === 0 && <li class="none">没有</li>}
          {drawer.have.map((d) => <li><a href={d.href}>{d.label}</a><span class="c">引用 {d.count} 次</span></li>)}
        </ul>
        <h3>空 ref（还没有页）</h3>
        <ul>
          {drawer.empty.length === 0 && <li class="none">没有</li>}
          {drawer.empty.map((d) => <li><span>{d.label}</span><span class="c">引用 {d.count} 次</span></li>)}
        </ul>
      </aside>
    )}

    <script>
      import { initSite } from '../lib/client.js';
      initSite();
    </script>
  </body>
</html>
