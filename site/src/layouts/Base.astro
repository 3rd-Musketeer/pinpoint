---
// 站点外壳：顶栏（回首页的“全部文章” + 面包屑 + 画布视图 + wiki + 深浅色）、左目录、正文、右评论栏、wiki 抽屉。
// 首页（/，全部文章）不传 project，顶栏左边只有“全部文章”，右边多一个“工作台”（ADR 0044）。
// 评论栏的内容由 pinpoint 注入的标注客户端填（src/client/prose-comments.js，[data-pp-rail]）；
// 没有注入（站点单独跑、以后的公开链接）时只留这句说明。
// overlay 槽：文章页放画布浮层（CanvasOverlay.astro），在 #article 之外。
import '../styles/layers.css';
import '../styles/tokens.css';
import '../styles/vendor/tailwind-typography.css';
import '../styles/site.css';

interface Crumb { label: string; href?: string }
interface TocItem { id: string; title: string; num: string }
interface DrawerItem { label: string; href?: string; count: number }
interface Props {
  title: string;
  description?: string;
  /** 所属 project（llms.txt 链接用）；首页不传。 */
  project?: string;
  crumbs: Crumb[];
  toc?: TocItem[];
  rail?: boolean;
  drawer?: { have: DrawerItem[]; empty: DrawerItem[] };
  errors?: string[];
  /** 文章的画布视图（/workbench/?page=<articlePageId>）；没有画布节的文章不传。 */
  canvasHref?: string;
  /** 正文排版（pp-prose）：文章页与 wiki 词条页打开，首页和 project 首页不用。 */
  prose?: boolean;
}
const { title, description, project, crumbs, toc, rail = false, drawer, errors = [], canvasHref, prose = false } = Astro.props;
const layoutClass = toc ? (rail ? 'layout' : 'layout no-rail') : 'layout single';
const llms = project ? `/${encodeURIComponent(project)}/llms.txt` : undefined;
// 顶栏左边永远从“全部文章”（/）起；首页自己就是它，不再链接。
const trail: Crumb[] = project ? [{ label: '全部文章', href: '/' }, ...crumbs] : crumbs;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {llms && <link rel="alternate" type="text/plain" href={llms} title="Agent 视图" />}
    <script is:inline>
      try { var t = localStorage.getItem('pp-site-theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    </script>
  </head>
  <body>
    <header class="top">
      <div class="crumb" data-pp-crumb>
        {trail.map((c, i) => (
          <>
            {i > 0 && <span>/</span>}
            {i === trail.length - 1 ? <b>{c.label}</b> : c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
          </>
        ))}
      </div>
      <div class="sp"></div>
      {canvasHref && <a class="btn" id="btn-canvas" href={canvasHref} target="_top">画布视图</a>}
      {drawer && (
        <button class="btn" id="btn-wiki" type="button" aria-controls="drawer" aria-expanded="false">
          wiki{drawer.empty.length > 0 && <span> · {drawer.empty.length} 个空 ref</span>}
        </button>
      )}
      {llms ? <a class="btn hide-sm" href={llms}>llms.txt</a> : <a class="btn" id="btn-workbench" href="/workbench/" target="_top">工作台</a>}
      <button class="btn" id="btn-theme" type="button" aria-label="切换深浅色">◐</button>
    </header>

    <div class={layoutClass}>
      {toc && (
        <nav class="toc" aria-label="目录">
          <div class="label">目录</div>
          <ol id="toc">
            {toc.map((s) => <li><a href={`#${s.id}`}><span class="n">{s.num}</span>{s.title}</a></li>)}
          </ol>
        </nav>
      )}
      <main id="article" class={prose ? 'pp-prose' : undefined}>
        {errors.length > 0 && (
          <div class="errors not-prose" role="alert">
            <b>内容错误（构建会失败）</b>
            <ul>{errors.map((e) => <li>{e}</li>)}</ul>
          </div>
        )}
        <slot />
      </main>
      {rail && (
        <aside class="rail" id="rail" aria-label="评论" data-pp-rail>
          <div class="label">评论</div>
          <p class="empty-rail">经本机 pinpoint 打开时，选中正文就能评论。</p>
        </aside>
      )}
    </div>

    <slot name="overlay" />

    {drawer && (
      <aside class="drawer" id="drawer" hidden aria-label="wiki">
        <h3>本篇用到的</h3>
        <ul>
          {drawer.have.length === 0 && <li class="none">没有</li>}
          {drawer.have.map((d) => <li><a href={d.href}>{d.label}</a><span class="c">引用 {d.count} 次</span></li>)}
        </ul>
        <h3>空 ref（还没有页）</h3>
        <ul>
          {drawer.empty.length === 0 && <li class="none">没有</li>}
          {drawer.empty.map((d) => <li><span>{d.label}</span><span class="c">引用 {d.count} 次</span></li>)}
        </ul>
      </aside>
    )}

    <script>
      import { initSite } from '../lib/client.js';
      initSite();
    </script>
  </body>
</html>
