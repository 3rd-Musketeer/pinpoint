---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Section from '../../../components/Section.astro';
import Canvas from '../../../components/Canvas.astro';
import CanvasOverlay from '../../../components/CanvasOverlay.astro';
import Figure from '../../../components/Figure.astro';
import Ref from '../../../components/Ref.astro';
import { loadSite, assertBuildClean, projectHref } from '../../../lib/site-data.js';
import { articleCanvas } from '../../../lib/projects-source.js';
import { canvasViewHref } from '../../../../../src/shared/workbench-url.js';
import { bannerErrors } from '../../../lib/site-errors.js';
import { renderArticle, syncingResponse } from '../../../lib/render-article.js';

export async function getStaticPaths() {
  const site = await loadSite();
  assertBuildClean(site);
  return [...site.projects.values()].flatMap((p) =>
    p.articles.map((a) => ({ params: { project: p.id, article: a.id }, props: { projectId: p.id, articleId: a.id } })));
}

const { projectId, articleId } = Astro.props;
const site = await loadSite();
Astro.locals.ppSite = site;
const p = site.projects.get(projectId);
const a = p.articles.find((x) => x.id === articleId);
// 刚写好的文章：内容库有了、渲染模块还没登记时回 503“内容同步中”（lib/render-article.js）。
const loadError = a.entry.data.loadError;
const body = loadError ? null : await renderArticle(a.entry, {
  render,
  moduleImports: async () => (await import('astro:content-module-imports')).default,
});
if (body?.syncing) return syncingResponse(a.title);
const { Content, remarkPluginFrontmatter } = body?.rendered || {};
const sections = remarkPluginFrontmatter?.sections || [];
// 这篇的画布（自动生成的页）：卡片从 locals 里取本节的帧；顶栏“画布视图”只在有画布节时出现。
// 正文里的图（<Figure>）也从这里取（canvas.figures，按 remark 注入的序号）。
const canvas = await articleCanvas(p.id, a.id);
Astro.locals.ppCanvas = canvas;
const canvasView = canvas.pageId && canvas.sections.length ? canvasViewHref(canvas.pageId) : undefined;

// 抽屉：本篇引用到的目标（按 project/名字 合并计数），已有与空 ref 分开。
const group = (refs) => {
  const m = new Map();
  for (const r of refs) {
    const key = `${r.project}\0${r.name}`;
    const cur = m.get(key) || { label: r.kind === 'article' ? r.item.title : r.project === p.id ? r.name : `${r.project}:${r.name}`, href: r.item?.href, count: 0 };
    cur.count += 1;
    m.set(key, cur);
  }
  return [...m.values()];
};
const drawer = { have: group(a.refs.filter((r) => r.kind !== 'empty')), empty: group(a.refs.filter((r) => r.kind === 'empty')) };
---
<Base
  title={a.title}
  description={a.summary}
  project={p.id}
  crumbs={[{ label: a.title }]}
  toc={sections}
  rail={true}
  drawer={drawer}
  errors={[...bannerErrors(p.id, p.layoutErrors, a.id, canvas), ...(loadError ? [loadError] : [])]}
  canvasHref={canvasView}
  prose
>
  <div class="prose">
    <h1>{a.title}</h1>
    {a.summary && <p class="lede">{a.summary}</p>}
    {/* project 只是装这篇文章的文件夹（ADR 0044）：读者面前不显示 project 标题那一行，只留一个小标签进文件夹。 */}
    <p class="meta"><a class="proj-tag" data-pp-project-tag href={projectHref(p.id)}>{p.title}</a></p>
  </div>
  <div class="article-body">
    {Content && <Content components={{ Section, Canvas, Figure, Ref }} />}
    {/* 正文结尾标记：正文渲染中途抛错时响应停在这之前，ppnt shot 靠它发现截到的是半篇（docs/registry.md“CLI”）。 */}
    <div data-pp-article-end hidden></div>
  </div>
  {canvasView && <CanvasOverlay slot="overlay" />}
</Base>
