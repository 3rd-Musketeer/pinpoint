---
// <Canvas frames={["<帧 id>", …]} shell?="comp" />：一节的画布卡片（common-m1.md §1、§3）。每帧按自己的 shell 取盒子（帧文件的 export const shell 盖过节的），
// 一张卡片里所有帧同一个缩放（canvas-card.js CARD_SCALE）。
// 只显示所在 Section 那一行的帧；数据来自文章页放进 Astro.locals.ppCanvas 的 articleCanvas()（lib/projects-source.js），
// 卡片根节点用 data-pp-section（不用 data-section：那是 Section 的，查 [data-section] 每节只该命中一个）。
// 不信本组件自己的 props：section 和 num（节号）由 remark-pinpoint 注入，frames / shell 只是作者写的源，解析与校验在 articleCanvas。
// 文章只显示数字：卡片头是节号 + 节标题，图注只有帧 id；画布字母（B、B1）留给工作台、ppnt 和标注，不进文章页。
// 文档帧（HTML 帧，shell doc）按 pinpoint 定的宽度显示（手机 402 / 桌面 1280，卡片头切换，缺省手机），卡片只露第一屏。
// 卡片不可交互：doc 帧是 tabindex -1、pointer-events none 的 iframe；静态帧（无运行时脚本、CSS 不依赖帧视口）
// 由 canvas-card-client 取编译好的帧 HTML 挂进 .cc-shadow 的 shadow root（带运行时脚本的帧回退 srcdoc iframe），
// noscript 时退回纯 iframe。点帧在文章上打开整张画布浮层并定位、选中这一帧
// （CanvasOverlay.astro，#canvas=<节>&frame=<帧>）；“打开画布”定位到节。都不跳页，修饰键点照常走链接。
// 头部的标注数（data-pp-badge）= 这一节画布上待验收的标注（open / check / done），浮层头读这里的 data-*。
// 错误只显示一次：带 section 的在本卡片里，页级的（含写在 Section 外的 Canvas，这时不出卡片）在页顶错误条。
// 缺源文件的帧照占位置，显示占位格“缺帧 <id>”，和画布上那一格的错误面板对应。
import { DOC_WIDTHS, cardModel } from '../lib/canvas-card.js';
import { canvasHash } from '../lib/canvas-overlay.js';

interface Props { section?: string; num?: string; frames?: unknown; shell?: string }
const { section, num } = Astro.props;
const m = cardModel(Astro.locals.ppCanvas, section, num);
// Each frame is sized by its own shell (frame-level `export const shell` over the section's): a card can mix phones and bare components.
const boxStyle = (box) => `width:${Math.round(box.width * box.scale)}px;height:${Math.round(box.height * box.scale)}px`;
const frameStyle = (box) => `width:${box.width}px;height:${box.height}px;transform:scale(${box.scale})`;
---
{!m.stray && (
<div
  class="canvas-card not-prose"
  data-pp-canvas
  data-page={m.pageId}
  data-pp-section={m.sectionId}
  data-num={m.num || undefined}
  data-title={m.title}
  data-meta={m.meta || undefined}
  data-href={m.href || undefined}
  data-shell={m.shell || undefined}
  data-doc-width={m.docWidth || undefined}
  data-frames={m.frames.map((f) => f.id).join(' ')}
>
  <div class="cc-head">
    <span class="kind">画布</span>
    {m.num && <span class="ref">{m.num}</span>}
    {m.title && <span class="t">{m.title}</span>}
    {m.frames.length > 0 && <span class="meta">{m.meta}</span>}
    <span class="sp"></span>
    <span class="cc-badge" data-pp-badge hidden></span>
    {m.docWidth && (
      <span class="pp-seg" role="group" aria-label="页面宽度" data-pp-width>
        {Object.entries(DOC_WIDTHS).map(([key, view]) => (
          <button type="button" data-width={key} aria-pressed={key === m.docWidth ? 'true' : 'false'} title={`按${view.label}宽度看（${view.width} px）`}>{view.label}</button>
        ))}
      </span>
    )}
    {m.href && <a class="btn" data-pp-open href={m.href} target="_top">打开画布 →</a>}
  </div>
  {m.errors.length > 0 && (
    <div class="cc-errors" role="alert" data-pp-canvas-errors>
      <b>这张画布卡片有错误</b>
      <ul>{m.errors.map((e) => <li>{e}</li>)}</ul>
    </div>
  )}
  {m.frames.length > 0 && (
    <div class="cc-strip">
      {m.frames.map((f) => (
        <figure class="cc-frame" data-screen={f.id} data-shell={f.shell || undefined} data-title={f.title} data-src={f.src || undefined} data-doc-url={f.docUrl || undefined} data-missing={f.missing ? '' : undefined}>
          <figcaption class="cap"><b>{f.id}</b></figcaption>
          {f.missing ? (
            <div class:list={['cc-box', f.box.mode, 'missing']} data-pp-missing style={boxStyle(f.box)}>
              <div class="ph">缺帧 {f.id}</div>
            </div>
          ) : (
            <div class:list={['cc-box', f.box.mode]} data-scale={f.box.scale} style={boxStyle(f.box)}>
              {f.box.mode === 'doc' ? (
                <iframe src={f.src} loading="lazy" tabindex="-1" aria-hidden="true" scrolling="no" title={f.title} style={frameStyle(f.box)}></iframe>
              ) : (
                <>
                  <div class="cc-shadow" data-cc-src={f.src} data-cc-w={f.box.width} data-cc-h={f.box.height} data-cc-title={f.title} aria-hidden="true"></div>
                  <noscript><iframe src={f.src} loading="lazy" tabindex="-1" aria-hidden="true" scrolling="no" title={f.title} style={frameStyle(f.box)}></iframe></noscript>
                </>
              )}
            </div>
          )}
          <a class="cc-hit" data-pp-frame-open href={canvasHash(m.sectionId, { frame: f.id })} aria-label={`在画布中打开 ${f.title}`}></a>
        </figure>
      ))}
    </div>
  )}
</div>
)}

<script>
  import { initCanvasCards } from '../lib/canvas-card-client.js';
  initCanvasCards();
</script>
